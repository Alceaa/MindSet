ENV="development"
PORT="8080"

DATABASE_USERNAME="postgres"
DATABASE_NAME="mindset"
DATABASE_PASSWORD="postgres"
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/mindset"

# Сгенерируйте свои значения: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="168h"

# Domain пустой = host-only cookie. SameSite=None требует Secure=true.
COOKIE_DOMAIN=""
COOKIE_SECURE="false"
COOKIE_SAME_SITE="Lax"

# Origin'ы фронтенда через запятую (CORS).
ALLOWED_ORIGINS="http://localhost:3000"

BCRYPT_COST="12"
