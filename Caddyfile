alceacore.ru {
	encode gzip zstd

	handle /mindset {
		redir /mindset/ 308
	}

	handle_path /mindset/api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle_path /mindset/media/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle_path /mindset/* {
		reverse_proxy 127.0.0.1:8081
	}

	handle /media/* {
		reverse_proxy 127.0.0.1:8080
	}
}