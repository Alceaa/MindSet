ENV="development"
PORT="8080"

DATABASE_USERNAME="postgres"
DATABASE_NAME="mindset"
DATABASE_PASSWORD="postgres"
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5432/mindset"

# Сгенерируйте свои значения: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="168h"

# Domain пустой = host-only cookie. SameSite=None требует Secure=true.
COOKIE_DOMAIN=""
COOKIE_SECURE="false"
COOKIE_SAME_SITE="Lax"

# Origin'ы фронтенда через запятую (CORS).
ALLOWED_ORIGINS="http://localhost:3000"

BCRYPT_COST="12"

# Объектное хранилище изображений сетов (S3-протокол: Timeweb Cloud, Cloudflare R2, MinIO).
# Оставьте пустыми, чтобы отключить вставку изображений (аватары работают локально).
# Timeweb Cloud: endpoint https://s3.twcstorage.ru, регион ru-1, бакет должен быть публичным.
S3_ENDPOINT=""
S3_REGION="ru-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# Публичный адрес объектов без слэша на конце:
#   Timeweb (path-style)   -> https://s3.twcstorage.ru/<bucket>
#   Timeweb (virtual-host) -> https://<bucket>.s3.twcstorage.ru
#   R2 / CDN / свой домен  -> https://<ваш-домен>
S3_PUBLIC_BASE_URL=""

# ── Почта: подтверждение адреса и сброс пароля ───────────────────────────────
# Куда ведут ссылки из писем (без слэша на конце). Пусто = берётся первый
# origin из ALLOWED_ORIGINS.
APP_BASE_URL="http://localhost:3000"
# Дополнительная проверка на входе: true = вход закрыт, пока почта не подтверждена.
# Регистрация в любом случае требует подтверждения — аккаунт создаётся по ссылке из письма.
REQUIRE_EMAIL_VERIFICATION="false"

# SMTP любого провайдера (Timeweb, Яндекс 360, Resend SMTP и т.д.).
# Оставьте SMTP_HOST и SMTP_FROM пустыми — письма будут печататься в лог сервера
# (удобно для dev: ссылку можно открыть прямо из консоли).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# starttls (587) | implicit (465) | none (25 — только локальный релей)
SMTP_TLS="starttls"

# ── Уведомления в Telegram ───────────────────────────────────────────────────
# Токен бота от @BotFather и id чата, куда бот пишет. Пусто = сообщения
# печатаются в лог сервера (удобно в dev).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Как часто монитор проверяет /health (по умолчанию каждые 2 часа).
HEALTH_CHECK_INTERVAL="2h"
# Внешний сервис-«пульс» (Healthchecks.io и подобные): адрес, куда бэкенд
# отправляет сигнал после каждой проверки. Пусто = выключено.
HEARTBEAT_URL=""
HEARTBEAT_INTERVAL="5m"

# ── Приглашения и доступ ─────────────────────────────────────────────────────
# Токен для управления приглашениями (/admin/invites). Пусто = маршруты выключены.
ADMIN_TOKEN=""
# true = регистрация только по одноразовым ссылкам-приглашениям.
REGISTRATION_INVITE_ONLY="false"
# Срок жизни приглашения по умолчанию.
INVITE_TTL_DAYS="7"

# ── Ограничения частоты запросов ─────────────────────────────────────────────
RATE_LIMIT_ENABLED="true"
# Общий лимит с одного IP в минуту.
RATE_LIMIT_GLOBAL_PER_MINUTE="240"
# Неудачные входы/коды/сбросы с одного IP на логин за 15 минут.
RATE_LIMIT_AUTH_PER_15MIN="10"
# Регистрации и запросы писем с одного IP в час.
RATE_LIMIT_EMAIL_PER_HOUR="5"
# Баг-репорты с одного IP в час.
RATE_LIMIT_REPORT_PER_HOUR="5"
# Реальный IP клиента за прокси (пусто = IP соединения).
TRUST_PROXY_HEADER="X-Forwarded-For"
