# ==== docker compose ====
# Домен, на который указывает A-запись. Caddy выпустит TLS автоматически.
DOMAIN="alceacore.ru"

# ==== готовые образы из GHCR (для docker-compose.images.yml) ====
# Совпадает с git-тегом вместе с буквой v: v1.1.0
MINDSET_TAG="v1.1.0"

# ==== база данных (используется сервисом db и бэкендом) ====
DATABASE_USERNAME="mindset"
DATABASE_PASSWORD="change-me-strong-password"
DATABASE_NAME="mindset"

# ==== бэкенд ====
ENV="production"
# Сгенерируйте: openssl rand -hex 32 (два разных значения!)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="168h"

# Один домен (Caddy + фронт на том же origin): cookies Lax + Secure
ALLOWED_ORIGINS="https://alceacore.ru"
COOKIE_SAME_SITE="Lax"
COOKIE_SECURE="true"
BCRYPT_COST="12"

# Приложение живёт по подпути /mindset (корень домена занят другими проектами)
REACT_APP_BASE_API_URL="/mindset/api"
PUBLIC_URL="/mindset"

# ==== S3-хранилище изображений сетов (Timeweb Cloud) ====
# Заполните, чтобы включить вставку картинок. Пусто = функция отключена
# (аватары при этом продолжают работать локально).
# Бакет должен быть ПУБЛИЧНЫМ, иначе картинки не откроются по прямой ссылке.
S3_ENDPOINT="https://s3.twcstorage.ru"
S3_REGION="ru-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="mindset-media"
# Публичный адрес объектов, без слэша на конце
S3_PUBLIC_BASE_URL="https://s3.twcstorage.ru/mindset-media"

# ==== почта: подтверждение адреса и сброс пароля ====
# Публичный адрес фронтенда — на него ведут ссылки из писем.
APP_BASE_URL="https://alceacore.ru/mindset"
# true = без подтверждённой почты вход запрещён (можно включить позже).
REQUIRE_EMAIL_VERIFICATION="false"

# SMTP провайдера. Пусто = письма печатаются в лог контейнера (фича отключена).
SMTP_HOST="smtp.timeweb.ru"
SMTP_PORT="587"
SMTP_USER="no-reply@alceacore.ru"
SMTP_PASSWORD=""
SMTP_FROM="MindSet <no-reply@alceacore.ru>"
# starttls (587) | implicit (465) | none (25 — только локальный релей)
SMTP_TLS="starttls"

# ==== Telegram: баг-репорты, ошибки 5xx, мониторинг /health ====
# Токен бота от @BotFather и id чата. Пусто = сообщения печатаются в лог контейнера.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Как часто монитор проверяет /health (по умолчанию каждые 2 часа).
HEALTH_CHECK_INTERVAL="2h"

# ==== внешний «пульс» мониторинга (Healthchecks.io и подобные) ====
# Бэкенд отправляет сигнал после каждой проверки; если сигналов нет — сервис шлёт алерт в Telegram.
HEARTBEAT_URL=""
HEARTBEAT_INTERVAL="5m"

# ==== приглашения: закрытая регистрация ====
# Токен для выдачи приглашений. Сгенерируйте: openssl rand -hex 32
ADMIN_TOKEN="change-me-admin-token"
# true = зарегистрироваться можно только по одноразовой ссылке-приглашению.
REGISTRATION_INVITE_ONLY="true"
INVITE_TTL_DAYS="7"

# ==== ограничения частоты запросов ====
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_GLOBAL_PER_MINUTE="240"
RATE_LIMIT_AUTH_PER_15MIN="10"
RATE_LIMIT_EMAIL_PER_HOUR="5"
RATE_LIMIT_REPORT_PER_HOUR="5"
# Backend доступен только через Caddy, поэтому доверяем его заголовку с IP.
TRUST_PROXY_HEADER="X-Forwarded-For"
